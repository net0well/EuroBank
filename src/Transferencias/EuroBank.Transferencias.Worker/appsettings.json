{
  "ConnectionStrings": {
    "Transferencias": "Host=localhost;Port=5434;Database=eurobank_transferencias;Username=eurobank;Password=eurobank"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GrupoConsumidor": "eurobank-transferencias-worker"
  },
  "Saga": {
    "PrazoDebito": "00:00:30",
    "PrazoLiquidacao": "00:00:30",
    "PrazoConsulta": "00:00:15",
    "PrazoEstorno": "00:00:30",
    "PrazoReconciliacao": "00:00:30",
    "PrazoCreditoDevolucao": "00:00:30",
    "ReenviosPorPasso": 3
  },
  "Varredura": {
    "Intervalo": "00:00:02",
    "Lote": 50
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Wolverine": "Warning",
        "JasperFx": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
