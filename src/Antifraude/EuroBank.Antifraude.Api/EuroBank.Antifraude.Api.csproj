<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Fornece google/api/annotations.proto e http.proto (rotas REST do JSON transcoding no .proto). -->
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both: o cliente gerado aqui serve aos testes da API; os outros contextos geram o próprio cliente. -->
    <Protobuf Include="Protos\antifraude.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EuroBank.Antifraude.Application\EuroBank.Antifraude.Application.csproj" />
    <ProjectReference Include="..\EuroBank.Antifraude.Infrastructure\EuroBank.Antifraude.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\EuroBank.Shared.Web\EuroBank.Shared.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
