<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["EuroBank.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoInterativo" />
</head>

<body>
    <Routes @rendermode="ModoInterativo" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    // Todo o painel é interativo no servidor, sem pré-renderização: as telas carregam uma vez, já com o circuito, e o
    // nome do analista (guardado no navegador) está disponível desde o começo.
    private static readonly IComponentRenderMode ModoInterativo = new InteractiveServerRenderMode(prerender: false);
}
