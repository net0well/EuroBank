@page "/antifraude"
@implements IDisposable
@inject ClienteAntifraude Antifraude
@inject AvisosFila Avisos
@inject ISnackbar Alertas

<PageTitle>Antifraude: visão geral</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Visão geral das últimas 24 horas</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="CarregarAsync" aria-label="Atualizar" />
</MudStack>

@if (_visao is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        <Indicador Titulo="Análises" Valor="@_visao.Analises.ToString(CultureInfo.InvariantCulture)" />
        <Indicador Titulo="Taxa de revisão" Valor="@Formatos.Percentual(_visao.TaxaRevisao)" />
        <Indicador Titulo="Taxa de recusa" Valor="@Formatos.Percentual(_visao.TaxaRecusa)" />
        <Indicador Titulo="Casos pendentes" Valor="@_visao.CasosPendentes.ToString(CultureInfo.InvariantCulture)" Href="antifraude/casos" />
        <Indicador Titulo="Casos expirados" Valor="@_visao.CasosExpirados.ToString(CultureInfo.InvariantCulture)" />
        <Indicador Titulo="Minutos até a decisão" Valor="@(_visao.MinutosMediosAteDecisao is { } minutos ? Formatos.Decimal(minutos, 1) : "-")" />
    </MudGrid>

    <MudGrid Class="mt-2">
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Decisões</MudText>
                @foreach (var (decisao, quantidade) in _visao.PorDecisao.OrderByDescending(par => par.Value))
                {
                    <MudChip T="string" Color="Formatos.CorDecisao(decisao)">@decisao: @quantidade</MudChip>
                }
                <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Regras que mais dispararam</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        @foreach (var regra in _visao.RegrasMaisDisparadas)
                        {
                            <tr><td>@regra.Codigo</td><td class="painel-numero" style="text-align: right">@regra.Vezes</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Drift do modelo ativo</MudText>
                <PainelDrift Drift="_visao.Drift" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private VisaoGeral? _visao;
    private IDisposable? _assinatura;

    protected override async Task OnInitializedAsync()
    {
        _assinatura = Avisos.Assinar(AoReceberAviso);
        await CarregarAsync();
    }

    /// <summary>Um caso entrou ou saiu da fila: os números mudaram.</summary>
    private void AoReceberAviso(AvisoFila aviso) => _ = InvokeAsync(async () =>
    {
        await CarregarAsync();
        StateHasChanged();
    });

    private async Task CarregarAsync()
    {
        try
        {
            _visao = await Antifraude.ObterVisaoGeralAsync(CancellationToken.None);
        }
        catch (Exception erro) when (erro is ExcecaoApiAntifraude or HttpRequestException)
        {
            Alertas.Add($"Não foi possível ler a visão geral: {erro.Message}", Severity.Error);
        }
    }

    public void Dispose() => _assinatura?.Dispose();
}
