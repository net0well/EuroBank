@page "/antifraude/casos"
@implements IDisposable
@inject ClienteAntifraude Antifraude
@inject AvisosFila Avisos
@inject ISnackbar Alertas

<PageTitle>Fila de casos</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h5">Fila de casos</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudSelect T="string" Value="_status" ValueChanged="TrocarStatusAsync" Label="Situação" Dense="true" Variant="Variant.Outlined" Style="min-width: 14rem">
            @foreach (var (valor, rotulo) in Situacoes)
            {
                <MudSelectItem T="string" Value="valor">@rotulo</MudSelectItem>
            }
        </MudSelect>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="CarregarAsync" aria-label="Atualizar" />
    </MudStack>
</MudStack>

<MudTable T="CasoResumo" Items="_casos" Dense="true" Hover="true" Loading="_carregando" Elevation="1">
    <HeaderContent>
        <MudTh>Score</MudTh>
        <MudTh>Situação</MudTh>
        <MudTh Style="text-align: right">Valor</MudTh>
        <MudTh>Destino</MudTh>
        <MudTh>Analista</MudTh>
        <MudTh>Aberto em</MudTh>
        <MudTh>Expira em</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Score"><MudChip T="string" Color="CorScore(context.ScoreFinal)" Size="Size.Small">@context.ScoreFinal</MudChip></MudTd>
        <MudTd DataLabel="Situação"><MudChip T="string" Color="Formatos.CorDecisao(context.Estado)" Size="Size.Small" Variant="Variant.Outlined">@context.Estado</MudChip></MudTd>
        <MudTd DataLabel="Valor" Style="text-align: right" Class="painel-numero">@Formatos.Valor(context.Valor, context.Moeda)</MudTd>
        <MudTd DataLabel="Destino">@(context.IbanDestino ?? context.TipoOperacao)</MudTd>
        <MudTd DataLabel="Analista">@(context.Analista ?? "-")</MudTd>
        <MudTd DataLabel="Aberto em">@Formatos.Data(context.AbertoEm)</MudTd>
        <MudTd DataLabel="Expira em">@Formatos.Data(context.ExpiraEm)</MudTd>
        <MudTd><MudButton Href="@($"antifraude/casos/{context.Id}")" Variant="Variant.Text" Size="Size.Small">Abrir</MudButton></MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Nenhum caso nesta situação.</MudText>
    </NoRecordsContent>
</MudTable>
<MudText Typo="Typo.caption" Class="mt-2">@_total caso(s); a fila atualiza sozinha quando um caso entra ou sai.</MudText>

@code {
    /// <summary>Vazio: os pendentes (abertos e em análise), os que expiram primeiro no topo.</summary>
    private static readonly (string Valor, string Rotulo)[] Situacoes =
    [
        (string.Empty, "Pendentes"),
        ("Aberto", "Abertos"),
        ("EmAnalise", "Em análise"),
        ("Aprovado", "Aprovados"),
        ("Recusado", "Recusados"),
        ("Expirado", "Expirados"),
        ("CanceladoPeloCliente", "Cancelados pelo cliente"),
    ];

    private const int Tamanho = 50;

    private string _status = string.Empty;
    private IReadOnlyList<CasoResumo> _casos = [];
    private long _total;
    private bool _carregando = true;
    private IDisposable? _assinatura;

    protected override async Task OnInitializedAsync()
    {
        _assinatura = Avisos.Assinar(AoReceberAviso);
        await CarregarAsync();
    }

    private async Task TrocarStatusAsync(string status)
    {
        _status = status;
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            var pagina = await Antifraude.ListarCasosAsync(_status, 1, Tamanho, CancellationToken.None);
            _casos = pagina.Itens;
            _total = pagina.Total;
        }
        catch (Exception erro) when (erro is ExcecaoApiAntifraude or HttpRequestException)
        {
            Alertas.Add($"Não foi possível ler a fila: {erro.Message}", Severity.Error);
        }
        finally
        {
            _carregando = false;
        }
    }

    /// <summary>Um caso entrou ou saiu: avisa e recarrega a fila, sem o analista recarregar a página.</summary>
    private void AoReceberAviso(AvisoFila aviso) => _ = InvokeAsync(async () =>
    {
        Alertas.Add(
            aviso.CasoNovo
                ? $"Caso novo na fila: score {aviso.ScoreFinal}."
                : $"Caso fechado: {aviso.Decisao} ({aviso.Analista ?? aviso.Origem}).",
            aviso.CasoNovo ? Severity.Warning : Severity.Info);
        await CarregarAsync();
        StateHasChanged();
    });

    private static Color CorScore(int score) => score >= 70 ? Color.Error : score >= 30 ? Color.Warning : Color.Success;

    public void Dispose() => _assinatura?.Dispose();
}
