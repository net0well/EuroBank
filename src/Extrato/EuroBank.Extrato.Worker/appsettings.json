{
  "ConnectionStrings": {
    "Extrato": "Host=localhost;Port=5434;Database=eurobank_extrato;Username=eurobank;Password=eurobank",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "Estrategia": "WriteThrough",
    "TtlCacheAside": "00:00:30",
    "IntervaloDescarga": "00:00:01",
    "IntervaloReconstrucao": "00:00:05"
  },
  "Seguranca": {
    "ApiKey": "extrato-lab-key"
  },
  "LimiteRequisicoes": {
    "Ativo": true,
    "PorSegundo": 100
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GrupoConsumidor": "eurobank-extrato"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Wolverine": "Warning",
        "JasperFx": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
