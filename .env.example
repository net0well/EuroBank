# Configuração do laboratório para o docker compose. Copie para .env antes do primeiro "docker compose up":
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# Os valores existem só para o ambiente local; o .env fica fora do git.

# PostgreSQL (o Debezium e as aplicações usam este usuário)
POSTGRES_USER=eurobank
POSTGRES_PASSWORD=eurobank

# Uma API key por API (header X-Api-Key; no gRPC do antifraude, metadata x-api-key). Os roteiros http/ e o k6 já
# usam estes valores.
CONTAS_API_KEY=contas-lab-key
EXTRATO_API_KEY=extrato-lab-key
TRANSFERENCIAS_API_KEY=transferencias-lab-key
ANTIFRAUDE_API_KEY=antifraude-lab-key

# Portas do host, para quando outro projeto já ocupa as padrão (descomente e troque).
# POSTGRES_PORTA_HOST=5434
# MAILPIT_PORTA_UI=8025
# MAILPIT_PORTA_SMTP=1025
# REDIS_PORTA_HOST=6379
# REDISINSIGHT_PORTA=5540

# Comportamento do laboratório (os padrões estão no docker-compose.yml; descomente para mudar).
# SAGA_ANALISE_RISCO=true
# SEPA_HORARIO_DE_CORTE=true
# ANTIFRAUDE_ESTRATEGIA=Retry
# ANTIFRAUDE_PRAZO_REVISAO=00:30:00
# EXTRATO_CACHE_ESTRATEGIA=WriteThrough
# RATE_LIMIT_POR_SEGUNDO=100
